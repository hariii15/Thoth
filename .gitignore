# Operating System Files
.DS_Store          # macOS specific
Thumbs.db          # Windows specific

# IDE / Editor specific files and directories
.vscode/           # VS Code settings (optional, some prefer to share)
.idea/             # IntelliJ/WebStorm/PyCharm/etc. IDE project files
*.sublime-project
*.sublime-workspace
.project           # Eclipse

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (Crucial for security!)
# Make sure to NEVER commit files with sensitive info like API keys, database credentials.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# General temporary files
*.tmp
*.temp
*~